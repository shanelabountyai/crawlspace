{
  "name": "crawlspace",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-readiness scanner: scorecard of how well AI agents can read and act on a site.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev -p 7900",
    "build": "next build",
    "start": "next start -p 7900",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:fixture": "tsx scripts/scan-fixture.ts",
    "scan": "tsx scripts/scan.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "e2e": "playwright test",
    "demo": "next build && tsx scripts/e2e-server.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "cheerio": "^1.2.0",
    "next": "^16.4.6",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
